# OS
.DS_Store
Thumbs.db

# Secrets — none of these ever belong here
.env
*.key
*.pem
*.token
secrets/

# Editor artifacts
.vscode/
.idea/
.claude/
.aider*
.agents/agents/
*.swp
*~

# Python (scripts/ tooling — venv never committed)
.venv/
__pycache__/
*.pyc

# Graphify output (local, regenerated)
graphify-out/

# Verification receipts ARE evidence and evidence is truth: committed since
# 2026-08-14 (operator decision - sole-source-local evidence is discardable
# evidence). Re-runs append new timestamped files; history is the point.
*.knobs.json
# Runtime tests and the return-path bridge overwrite this mock receipt's
# generated_at on every run. Keep it untracked so timestamp-only churn
# cannot dirty the working tree. evaluations.yaml stays tracked; the
# exporter must merge and skip no-op writes rather than gitignoring it.
verification/**/auth-node.json
# ByteRover — .brv/context-tree/ contains a nested .git managed by brv vc.
# Without these entries, `git add .` fails with "does not have a commit checked out".
.brv/

# vectorcode local index
.vectorcode/

# Remember plugin — local session logs, not repo artifacts
.remember/

# generated by graphify commit hook — rebuildable, never commit
graphify-out/

# Understand-Anything scratch artifacts (never commit)
.ua/

# Pi — only understand skill symlinks are tracked under .pi/skills/
.pi-subagents/
.pi/*
!.pi/skills/
.pi/skills/*
!.pi/skills/understand
!.pi/skills/understand-*

# Understand Anything: share the durable graph snapshot, ignore transient work.
.ua/.trash-*/
.ua/intermediate/*
!.ua/intermediate/scan-result.json
