{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GDAD journal line",
  "type": "object",
  "required": ["v", "ts", "type", "who", "state", "run_id", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "ts": { "type": "string" },
    "type": {
      "enum": ["dispatch", "pause", "resume", "packet", "decision", "review", "verdict", "steer", "gate", "blocked"]
    },
    "who": { "type": "string" },
    "state": {
      "enum": ["pending", "running", "paused", "review", "awaiting-decision", "accepted", "rejected", "blocked"]
    },
    "run_id": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "note": { "type": "string" },
    "request_id": { "type": "string" },
    "wid": { "type": "string" }
  }
}
