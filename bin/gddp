#!/usr/bin/env bash
# Portable gddp launcher.
# Order: GDDP_CONFIG_PATH → this script's repo root (symlink-safe) → known layouts.
set -euo pipefail

_resolve_self_root() {
  local source dir
  source="${BASH_SOURCE[0]}"
  # Follow symlinks so ~/bin/gddp → .../gddp-config/bin/gddp still works.
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  dir="$(cd -P "$(dirname "$source")/.." && pwd)"
  if [[ -f "$dir/scripts/gddp.py" ]]; then
    printf '%s\n' "$dir"
    return 0
  fi
  return 1
}

_resolve_root() {
  if [[ -n "${GDDP_CONFIG_PATH:-}" && -f "${GDDP_CONFIG_PATH}/scripts/gddp.py" ]]; then
    printf '%s\n' "$GDDP_CONFIG_PATH"
    return 0
  fi
  if _resolve_self_root; then
    return 0
  fi
  local candidate
  for candidate in \
    "$HOME/gddp-config" \
    "$HOME/repos/gddp-config" \
    "/Users/sab-mini/repos/gddp-config"; do
    if [[ -f "$candidate/scripts/gddp.py" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

if ! ROOT="$(_resolve_root)"; then
  echo "gddp: could not find gddp-config checkout." >&2
  echo "  Set GDDP_CONFIG_PATH, or install this script from a gddp-config clone." >&2
  exit 1
fi

# Operator actions that dispatch work need the same executor environment as
# the mini-heartbeat. Source its canonical local env before entering Python.
_RUNTIME_ROOT="${GDDP_RUNTIME_ROOT:-$HOME/repos/gddp-runtime}"
_RUNTIME_ENV="${MINI_HEARTBEAT_ENV:-$_RUNTIME_ROOT/deploy/mini-heartbeat/env/gddp.env}"
if [[ -f "$_RUNTIME_ENV" ]]; then
  # shellcheck disable=SC1090
  source "$_RUNTIME_ENV"
fi

if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
else
  PY="python3"
fi

exec "$PY" "$ROOT/scripts/gddp.py" "$@"
