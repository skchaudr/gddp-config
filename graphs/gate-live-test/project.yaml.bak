schema_version: '1.0'
schema_type: project_graph
project_id: gate-live-test
project_name: Gate Live-Fire Smoke Test
description: "Live-fire test of the gate-token mechanism through the real heartbeat loop on sab-mini. One tiny node, one token write, one revocation."
repo: skchaudr/gddp-runtime
blueprint:
  vision: "Verify the gate writer and revocation path work end-to-end in the real loop, not just pytest. Token must appear on verdict pass, disappear on human rejection."
  architecture_notes: "Single-node smoke graph. Target repo is gddp-runtime itself. Binary criteria only."
  major_capabilities:
  - "Gate token write on verdict pass"
  - "Gate token revocation on human rejection"
graph_version: '1.0'
created_at: '2026-08-07'
last_updated: '2026-08-07'
nodes_dir: nodes/
nodes: []
execution_policy:
  default_executor: droid
  max_concurrent_jobs: 1
  frontier_auto_advance: true
  retry_budget: 3
  require_human_review_before_overnight: false
  artifact_gate_enforced: true
